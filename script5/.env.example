# ============================================================
# script5/.env.example
#
# Cách dùng:
#   cp script5/.env.example script5/.env
#   sửa script5/.env
#   node script5/crawl.js
#
# Script tự đọc script5/.env.
# Biến truyền từ shell/CLI vẫn ưu tiên hơn file .env.
# ============================================================

# ── Danh sách profile ────────────────────────────────────────
# Thứ tự ưu tiên: CLI > PHOTOS_URLS/PHOTOS_URL > profiles.txt
#
# Nhiều link, cách nhau dấu phẩy hoặc xuống dòng:
# PHOTOS_URLS=https://www.facebook.com/account1/photos,https://www.facebook.com/account2/photos
#
# Hoặc 1 link:
# PHOTOS_URL=https://www.facebook.com/genkosama/photos
#
# Hoặc dùng file danh sách (mặc định là script5/profiles.txt):
# PROFILES_FILE=/duong/dan/tuyet/doi/profiles.txt

# ── Bước 1: crawl danh sách ảnh ─────────────────────────────
HEADLESS=0
FORCE_LOGIN=1

# Chờ login tối đa 5 phút
LOGIN_WAIT_MS=300000

# Scroll chậm, đợi ảnh tải xong
SCROLL_PAUSE_MS=4000
SCROLL_STEP_RATIO=0.75
IMAGE_SETTLE_MS=1200
IMAGE_LOAD_TIMEOUT_MS=5000
STUCK_EXTRA_WAIT_MS=8000
MAX_STUCK_ROUNDS=6
MAX_SCROLL_ROUNDS=3000

# Bỏ avatar/icon nhỏ
MIN_IMAGE_SIZE=200
MIN_IMAGE_BYTES=15000

# 0 = chỉ ảnh do acc đăng, 1 = lấy cả ảnh được gắn thẻ
INCLUDE_TAGGED=0

# 1 = chỉ scan bổ sung web_url cho record đang thiếu, không thêm ảnh mới
FILL_WEB_URLS_ONLY=0

# 0 = lưu session Facebook vào PROFILE_DIR, 1 = không lưu
NO_PERSISTENT_PROFILE=0

# Ghi JSON mỗi 1 giây khi có ảnh mới
SAVE_DEBOUNCE_MS=1000

# Đường dẫn tuỳ chọn (mặc định nằm trong script5/)
# DATA_DIR=/duong/dan/data
# OUTPUT_FILE chỉ dùng khi chạy trực tiếp 1 profile với SINGLE_PROFILE_RUN=1.
# Nếu đổi OUTPUT_FILE, đặt INPUT_FILE giống đường dẫn đó cho bước 2 và 3.
# OUTPUT_FILE=/duong/dan/fb_user_images.json
# PROFILE_DIR=/duong/dan/.fb-profile

# ── Bước 2: lấy ảnh gốc ─────────────────────────────────────
# Số photo viewer mở song song. Tăng lên 3 nếu mạng tốt.
ORIGINALS_CONCURRENCY=2
VIEWER_WAIT_MS=1800
VIEWER_PAUSE_MS=700
VIEWER_RETRIES=3
RETRY_DELAY_MS=3000

# 1 = lấy lại cả ảnh đã success
REFRESH_ORIGINALS=0

# 1 = chỉ lấy lại record có URL bị mất stp / chữ ký lỗi
REFRESH_INVALID_URLS=0

# 1 = không kiểm tra login (chỉ dùng cho nội dung public)
SKIP_LOGIN=0

# ── Bước 3: tải ảnh ─────────────────────────────────────────
DOWNLOAD_CONCURRENCY=5
TIMEOUT_MS=30000
MAX_RETRIES=3

# 1 = tự khôi phục URL cũ bị mất stp trước khi tải (mặc định bật)
REPAIR_URLS=1

# 1 = tách thêm thư mục photo/<profile>/ bên trong PHOTO_DIR.
# Mặc định 0 vì mỗi profile đã có PHOTO_DIR riêng.
PHOTO_USE_PROFILE_DIR=0

# Đường dẫn tuỳ chọn (mặc định nằm trong script5/)
# PHOTO_DIR=/duong/dan/photo
# STATUS_FILE=/duong/dan/download_status.json
# INPUT_FILE=/duong/dan/fb_user_images.json